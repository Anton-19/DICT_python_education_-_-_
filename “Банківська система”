import sqlite3
import random


# Підключення до бази даних
def create_connection():
    return sqlite3.connect('card.s3db')


# Створення таблиці
def create_table():
    with create_connection() as conn:
        cur = conn.cursor()
        cur.execute('''
            CREATE TABLE IF NOT EXISTS card (
                id INTEGER PRIMARY KEY,
                number TEXT,
                pin TEXT,
                balance INTEGER DEFAULT 0
            )
        ''')
        conn.commit()


# Алгоритм Луна — переврка контрольної суми
def luhn_checksum(card_number):
    digits = [int(d) for d in card_number]
    for i in range(0, len(digits), 2):
        digits[i] *= 2
        if digits[i] > 9:
            digits[i] -= 9
    return sum(digits) % 10


# Генерація номера картки
def generate_number():
    while True:
        number = '400000' + ''.join(str(random.randint(0, 9)) for _ in range(9))
        checksum = (10 - luhn_checksum(number + '0')) % 10
        card_number = number + str(checksum)
        if not card_exists(card_number):
            return card_number


# Генерація пін коду картки
def generate_pin():
    return ''.join(str(random.randint(0, 9)) for _ in range(4))


# Перевірка, чи існує картка в базі
def card_exists(card_number):
    with create_connection() as conn:
        cur = conn.cursor()
        cur.execute('SELECT * FROM card WHERE number = ?', (card_number,))
        return cur.fetchone() is not None

# Створення рахунку та збереження у базі
def create_account():
    number = generate_number()
    pin = generate_pin()
    with create_connection() as conn:
        cur = conn.cursor()
        cur.execute('INSERT INTO card (number, pin) VALUES (?, ?)', (number, pin))
        conn.commit()
    print("\nYour card has been created")
    print("Your card number:")
    print(number)
    print("Your card PIN:")
    print(pin)


# Вхід до акаунту за номером і пін кодом
def login():
    print("\nEnter your card number:")
    number = input("> ")
    print("Enter your PIN:")
    pin = input("> ")
    with create_connection() as conn:
        cur = conn.cursor()
        cur.execute('SELECT * FROM card WHERE number = ? AND pin = ?', (number, pin))
        account = cur.fetchone()
        if account:
            print("\nYou have successfully logged in!")
            return number
        else:
            print("\nWrong card number or PIN!")
            return None

# Баланс облікового запису
def get_balance(card_number):
    with create_connection() as conn:
        cur = conn.cursor()
        cur.execute('SELECT balance FROM card WHERE number = ?', (card_number,))
        return cur.fetchone()[0]


# Поповнення рахунку
def add_income(card_number):
    print("\nEnter income:")
    try:
        amount = int(input("> "))
        with create_connection() as conn:
            cur = conn.cursor()
            cur.execute('UPDATE card SET balance = balance + ? WHERE number = ?', (amount, card_number))
            conn.commit()
        print("Income was added!")
    except ValueError:
        print("Invalid amount!")


# Перевірка, чи проходить алгоритм Луна
def is_valid_luhn(card_number):
    return luhn_checksum(card_number) == 0


# Переказ грошей на іншу картку
def transfer(card_number):
    print("\nTransfer")
    print("Enter card number:")
    target = input("> ")

    if not target.isdigit():
        print("Invalid input! Card number must be numeric.")
        return

    if target == card_number:
        print("You can't transfer money to the same account!")
        return

    if not is_valid_luhn(target):
        print("Probably you made a mistake in the card number. Please try again!")
        return

    if not card_exists(target):
        print("Such a card does not exist.")
        return

    print("Enter how much money you want to transfer:")
    try:
        amount = int(input("> "))
        if get_balance(card_number) < amount:
            print("Not enough money!")
            return
        with create_connection() as conn:
            cur = conn.cursor()
            cur.execute('UPDATE card SET balance = balance - ? WHERE number = ?', (amount, card_number))
            cur.execute('UPDATE card SET balance = balance + ? WHERE number = ?', (amount, target))
            conn.commit()
        print("Success!")
    except ValueError:
        print("Invalid amount!")


# Закриття акаунту
def close_account(card_number):
    with create_connection() as conn:
        cur = conn.cursor()
        cur.execute('DELETE FROM card WHERE number = ?', (card_number,))
        conn.commit()
    print("The account has been closed!")


# Меню після входу
def user_menu(card_number):
    while True:
        print("\n1. Balance\n2. Add income\n3. Do transfer\n4. Close account\n5. Log out\n0. Exit")
        choice = input("> ")
        if choice == "1":
            print("\nBalance:", get_balance(card_number))
        elif choice == "2":
            add_income(card_number)
        elif choice == "3":
            transfer(card_number)
        elif choice == "4":
            close_account(card_number)
            break
        elif choice == "5":
            print("You have successfully logged out!")
            break
        elif choice == "0":
            print("\nBye!")
            exit()


# Меню програми
def main_menu():
    create_table()
    while True:
        print("\n1. Create an account\n2. Log into account\n0. Exit")
        choice = input("> ")
        if choice == "1":
            create_account()
        elif choice == "2":
            card = login()
            if card:
                user_menu(card)
        elif choice == "0":
            print("\nBye!")
            exit()


if __name__ == "__main__":
    main_menu()
