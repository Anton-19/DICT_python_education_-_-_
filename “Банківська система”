import random
import sqlite3


# Ініціалізація бази даних
def init_db():
    conn = sqlite3.connect('card.s3db')
    cur = conn.cursor()
    cur.execute('''
        CREATE TABLE IF NOT EXISTS card (
            id INTEGER PRIMARY KEY,
            number TEXT,
            pin TEXT,
            balance INTEGER DEFAULT 0
        );
    ''')
    conn.commit()
    return conn, cur


# Генерація картки та PIN
def generate_card_number():
    IIN = "400000"
    account_id = str(random.randint(0, 999999999)).zfill(9)
    partial = IIN + account_id
    return partial + str(luhn_checksum(partial))


def generate_pin():
    return str(random.randint(0, 9999)).zfill(4)


def luhn_checksum(number):
    digits = [int(d) for d in number]
    for i in range(0, len(digits), 2):
        digits[i] *= 2
        if digits[i] > 9:
            digits[i] -= 9
    return (10 - sum(digits) % 10) % 10


def is_valid_luhn(number):
    checksum = int(number[-1])
    return luhn_checksum(number[:-1]) == checksum


# Робота з акаунтом
def create_account(cur, conn):
    while True:
        card = generate_card_number()
        cur.execute("SELECT number FROM card WHERE number = ?", (card,))
        if not cur.fetchone():
            break
    pin = generate_pin()
    cur.execute("INSERT INTO card (number, pin) VALUES (?, ?)", (card, pin))
    conn.commit()
    print("\nYour card has been created")
    print("Your card number:\n" + card)
    print("Your card PIN:\n" + pin)


def login(cur):
    card = input("\nEnter your card number:\n>")
    pin = input("Enter your PIN:\n>")
    cur.execute("SELECT * FROM card WHERE number = ? AND pin = ?", (card, pin))
    return cur.fetchone()


# Операції з акаунтом
def show_balance(cur, number):
    cur.execute("SELECT balance FROM card WHERE number = ?", (number,))
    print(f"\nBalance: {cur.fetchone()[0]}")


def add_income(cur, conn, number):
    income = int(input("\nEnter income:\n>"))
    cur.execute("UPDATE card SET balance = balance + ? WHERE number = ?", (income, number))
    conn.commit()
    print("Income was added!")


def do_transfer(cur, conn, sender_number):
    print("\nTransfer")
    target = input("Enter card number:\n>")
    if target == sender_number:
        print("You can't transfer money to the same account!")
        return
    if not is_valid_luhn(target):
        print("Probably you made a mistake in the card number. Please try again!")
        return
    cur.execute("SELECT * FROM card WHERE number = ?", (target,))
    if not cur.fetchone():
        print("Such a card does not exist.")
        return

    amount = int(input("Enter how much money you want to transfer:\n>"))
    cur.execute("SELECT balance FROM card WHERE number = ?", (sender_number,))
    current_balance = cur.fetchone()[0]
    if amount > current_balance:
        print("Not enough money!")
        return

    cur.execute("UPDATE card SET balance = balance - ? WHERE number = ?", (amount, sender_number))
    cur.execute("UPDATE card SET balance = balance + ? WHERE number = ?", (amount, target))
    conn.commit()
    print("Success!")


def close_account(cur, conn, number):
    cur.execute("DELETE FROM card WHERE number = ?", (number,))
    conn.commit()
    print("The account has been closed!")


# Меню
def main_menu():
    print("\n1. Create an account")
    print("2. Log into account")
    print("0. Exit")


def account_menu():
    print("\n1. Balance")
    print("2. Add income")
    print("3. Do transfer")
    print("4. Close account")
    print("5. Log out")
    print("0. Exit")


def run_account_session(cur, conn, account):
    while True:
        account_menu()
        choice = input(">")
        if choice == "1":
            show_balance(cur, account[1])
        elif choice == "2":
            add_income(cur, conn, account[1])
        elif choice == "3":
            do_transfer(cur, conn, account[1])
        elif choice == "4":
            close_account(cur, conn, account[1])
            break
        elif choice == "5":
            print("You have successfully logged out!")
            break
        elif choice == "0":
            print("Bye!")
            exit()


# Головна
def main():
    conn, cur = init_db()
    while True:
        main_menu()
        choice = input(">")
        if choice == "1":
            create_account(cur, conn)
        elif choice == "2":
            account = login(cur)
            if account:
                print("You have successfully logged in!")
                run_account_session(cur, conn, account)
            else:
                print("Wrong card number or PIN!")
        elif choice == "0":
            print("Bye!")
            break

if __name__ == "__main__":
    main()
